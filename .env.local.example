# Copy this file to .env.local and fill private values.
# .env.local is gitignored and should never be committed.

# ---------- Chat routing ----------
# trial | byok
# APP settings can also be updated via /api/settings

# BYOK runtime (main chat/model calls)
# Used when app settings mode=byok
# Example providers: Kimi, DeepSeek, Qwen (OpenAI-compatible)
BYOK_MODE=trial
BYOK_BASE_URL=
BYOK_MODEL=
BYOK_API_KEY=

# ---------- Core endpoint registry bootstrap (private only) ----------
# These entries auto-create/update model endpoints in local DB at startup.
# provider: deepseek | qwen | kimi | openai | openai_compatible
CORE_ENDPOINT_PROVIDER=
CORE_ENDPOINT_BASE_URL=
CORE_ENDPOINT_MODEL=
CORE_ENDPOINT_API_KEY=
CORE_ENDPOINT_NAME=core-llm
CORE_ENDPOINT_ENABLED=1
CORE_ENDPOINT_PRIORITY=10
CORE_ENDPOINT_IS_FALLBACK=0

CHAT_ENDPOINT_PROVIDER=
CHAT_ENDPOINT_BASE_URL=
CHAT_ENDPOINT_MODEL=
CHAT_ENDPOINT_API_KEY=
CHAT_ENDPOINT_NAME=chat-llm
CHAT_ENDPOINT_ENABLED=1
CHAT_ENDPOINT_PRIORITY=20
CHAT_ENDPOINT_IS_FALLBACK=0

WIZARD_ENDPOINT_PROVIDER=
WIZARD_ENDPOINT_BASE_URL=
WIZARD_ENDPOINT_MODEL=
WIZARD_ENDPOINT_API_KEY=
WIZARD_ENDPOINT_NAME=wizard-llm
WIZARD_ENDPOINT_ENABLED=1
WIZARD_ENDPOINT_PRIORITY=30
WIZARD_ENDPOINT_IS_FALLBACK=0

# Optional trial proxy runtime
TRIAL_PROXY_MODE=local
TRIAL_PROXY_BASE_URL=
TRIAL_PROXY_MODEL=
TRIAL_PROXY_API_KEY=
TRIAL_PROXY_TIMEOUT_SECONDS=30

# ---------- RAG / memory ----------
CHAT_RECENT_MESSAGE_LIMIT=12
CHAT_SUMMARY_TRIGGER_MESSAGES=24
CHAT_SUMMARY_STEP_MESSAGES=10
CHAT_CONTEXT_CHAR_BUDGET=14000
CHAT_RAG_TOP_K=4

# Embedding (BGE via OpenAI-compatible endpoint)
BGE_EMBEDDING_BASE_URL=
BGE_EMBEDDING_MODEL=bge-m3
BGE_EMBEDDING_API_KEY=
BGE_EMBEDDING_TIMEOUT_SECONDS=20
BGE_EMBEDDING_FALLBACK_DIM=256

# ---------- Function Calling ----------
CHAT_ENABLE_FUNCTION_CALLING=1

# Tavily web search (for wizard/search tool)
TAVILY_API_KEY=

# ---------- Optional image model config ----------
# Reserved for next iteration (in-chat image generation execution)
IMAGE_BASE_URL=
IMAGE_MODEL=
IMAGE_API_KEY=
IMAGE_API_STYLE=auto
IMAGE_TIMEOUT_SECONDS=45
IMAGE_SIZE=1024x1024
IMAGE_RESPONSE_FORMAT=url
